# Committed defaults for the business app. Real values come from the environment (compose.yaml, deployment).
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# API runtime: business_reader (SELECT on reporting views only).
DATABASE_URL="postgresql://business_reader:change-me@db:5432/business?serverVersion=18&charset=utf8"
# Migrations and seed: business_owner.
MIGRATIONS_DATABASE_URL="postgresql://business_owner:change-me@db:5432/business?serverVersion=18&charset=utf8"
# Seeding replaces all business data; allowed only where this is 1 (local, test, public demo).
BUSINESS_ALLOW_SEED=0
# Bearer token expected from Tabularius. Empty = every API request is rejected.
BUSINESS_API_TOKEN=
