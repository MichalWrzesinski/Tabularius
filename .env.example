# Local development only. `make up` copies this to .env. Never reuse these values outside your machine.
POSTGRES_PASSWORD=local-postgres
TABULARIUS_MIGRATOR_PASSWORD=local-tabularius-migrator
TABULARIUS_APP_PASSWORD=local-tabularius-app
BUSINESS_OWNER_PASSWORD=local-business-owner
BUSINESS_READER_PASSWORD=local-business-reader
# Bearer token Tabularius uses for the demo business API (TASK-002).
BUSINESS_API_TOKEN=local-business-api-token
# Shared demo accounts shown on the login screens (public demo credentials, not a secret).
DEMO_SHARED_PASSWORD=Demo123!
# Symfony secrets (any random string locally).
API_APP_SECRET=local-api-secret-change-me
BUSINESS_APP_SECRET=local-business-secret-change-me
