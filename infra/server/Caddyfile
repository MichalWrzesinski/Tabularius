{
	admin off
	auto_https off
	# The host's nginx (via the Docker gateway) is the only proxy allowed to report the visitor's address.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# "all" when the owner allows indexing (STAGING_INDEX=true, 2026-11-24); otherwise kept out of search engines.
		X-Robots-Tag "{$SITE_ROBOTS}"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}

# Public entry behind the host's nginx (TLS there): dashboard and API on one origin (ADR 0003).
:80 {
	encode zstd gzip
	import security_headers

	# Private staging: one shared login for the whole environment, independent of the application's own login. Health
	# endpoints stay open for the deployment checks (no data). STAGING_PUBLIC=true (the public demo, opened by the owner on
	# 2026-11-24) turns the login off; anything else keeps it on.
	@protected {
		not path /api/health /api/ready
		expression "{$STAGING_PUBLIC}" != "true"
	}
	basic_auth @protected {
		{$STAGING_AUTH_USER} {$STAGING_AUTH_HASH}
	}

	# Errors (the environment login's 401 included) are answered on Caddy's error path, which needs its own headers.
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	# Crawling: the public pages only; the dashboards and the API need a login anyway. The meaning of indexing is set
	# by X-Robots-Tag above, so a crawler must be allowed to fetch a page to see it.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /admin
			Disallow: /moje-raporty
			Disallow: /api/
			Sitemap: https://{$SITE_DOMAIN}/sitemap.xml
			TXT 200
	}
	handle /sitemap.xml {
		header Content-Type "application/xml; charset=utf-8"
		respond <<XML
			<?xml version="1.0" encoding="UTF-8"?>
			<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
			<url><loc>https://{$SITE_DOMAIN}/</loc></url>
			<url><loc>https://{$SITE_DOMAIN}/logowanie</loc></url>
			<url><loc>https://{$SITE_DOMAIN}/regulamin</loc></url>
			<url><loc>https://{$SITE_DOMAIN}/polityka-prywatnosci</loc></url>
			</urlset>
			XML 200
	}

	redir /api /api/ 308

	# Symfony front controller in the api container (no PHP files on this side).
	handle /api/* {
		root * /app/public
		rewrite * /index.php
		reverse_proxy api:9000 {
			transport fastcgi {
				split .php
			}
		}
	}

	handle {
		reverse_proxy client:8080
	}
}

# Internal only (not published): the demo business system's API for api and worker.
:8081 {
	root * /app/public
	rewrite * /index.php
	reverse_proxy business:9000 {
		transport fastcgi {
			split .php
		}
	}
}
